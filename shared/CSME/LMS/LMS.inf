;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Intel,NTx86.10.0...16299, NTamd64.10.0...16299

[Intel.NTx86.10.0...16299]
%LMSDescription% = LMSInstallSection, SWC\5DCEB103-DD64-403C-A17C-94FC5F917A9C

[Intel.NTamd64.10.0...16299]
%LMSDescription% = LMSInstallSection, SWC\5DCEB103-DD64-403C-A17C-94FC5F917A9C


[LMSInstallSection]
; The install section is typically empty, but can contain entries that
; copy files or modify the registry.
CopyFiles = LMS_Files
AddReg    = LMS_Service_AddReg
Addreg    = LMS_COMServer_AddReg

[LMSInstallSection.Services]
AddService = , 0x00000002
AddService = LMS, %SPSVCSINST_STARTSERVICE%, LMS_Service_Inst

[LMSInstallSection.ntamd64]
CopyFiles = LMS_Files
AddReg    = LMS_Service_AddReg
Addreg    = LMS_COMServer_AddReg


[LMSInstallSection.ntamd64.Services]
AddService = , 0x00000002
AddService = LMS, %SPSVCSINST_STARTSERVICE%, LMS_Service_Inst

; -------------- LMS driver install sections
[LMS_Service_Inst]
DisplayName    = "Intel(R) Management and Security Application Local Management Service"
Description    = "Intel(R) Management and Security Application Local Management Service - Provides OS-related Intel(R) ME functionality."
ServiceType    = 0x00000010      ; SERVICE_WIN32_OWN_PROCESS
StartType      = 2               ; SERVICE_AUTO_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\LMS.exe


[LMS_Service_AddReg]
