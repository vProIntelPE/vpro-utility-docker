;
; issei.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System 
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318} 
Provider=%ManufacturerName%
CatalogFile=issei.cat
DriverVer = 10/22/2025,2543.9.0.0
PnpLockdown=1

[ControlFlags]
; Pnp drivers should not be installable via non-PnP hardware dialogs
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 13


[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
issei.sys  = 1,,


;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...17763

[Standard.NTamd64.10.0...17763]
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_A85D   ; LNL - SSE 
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_E35D   ; PTL - SSE PCD-H
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_E45D   ; PTL - SSE PCD-P
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_4D5D   ; WCL
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_D470   ;
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_D258   ;
%issei.DeviceDesc%=issei_Device, PCI\VEN_8086&DEV_D358   ;

[issei_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
issei.sys

;-------------- Service installation
[issei_Device.NT.Services]
AddService = issei,%SPSVCINST_ASSOCSERVICE%, issei_Service_Inst


[issei_NT_AddReg.Security]
%SECURITY_STRING%

; -------------- issei driver install sections
[issei_Service_Inst]
DisplayName    = %issei.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\issei.sys
AddReg=issei_NT_AddReg


[issei_Device.NT.HW]
AddReg=issei__NT_HW_AddReg

[issei__NT_HW_AddReg]
HKR,,DeviceCharacteristics,0x10001,0
HKR,,Security,,%SECURITY_STRING%
HKR, Interrupt Management,, 0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,, 0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties, MSISupported, 0x00010001, 1

[issei_Device.NT.Events]
AddEventProvider={9DBFDD56-F0A6-433D-AAC9-56C79D7E9D20},issei_etw

[issei_etw]
ProviderName  = IsseiDriver
ResourceFile  = %13%\issei.sys
MessageFile   = %13%\issei.sys
Enabled      = 1

[issei_Device.NT.Wdf]
KmdfService =  issei, issei_wdfsect
[issei_wdfsect]
KmdfLibraryVersion = 1.31

[issei_NT_AddReg]
;
HKR,Parameters,VerboseOn,%REG_DWORD%,0x0

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="Intel Corporation"
DiskName = "Intel (R) Silicon Security Engine Interface Installation Disk"
issei.DeviceDesc = "Intel(R) Silicon Security Engine Interface"
issei.SVCDESC = "Intel(R) Silicon Security Engine Interface Service"
SECURITY_STRING = "D:P(A;CI;GA;;;BA)(A;CI;GA;;;SY)(A;CI;GA;;;LS)"


REG_DWORD                   = 0x00010001
