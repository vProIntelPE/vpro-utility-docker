[Unit]
Description=Launches QEMU instance at container start
After=multi-user.target

[Service]
Environment=SYSTEMD_LOG_LEVEL=debug
Type=forking
EnvironmentFile=/envars
ExecStart=/bin/bash -c '/run/entry.sh > /dev/console &'
ExecStop=/bin/bash -c 'echo "system_powerdown" | nc -U /run/shm/monitor.sock -q 10'
TimeoutStopSec=20
KillMode=mixed
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
